# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify local knowledge graph (generated; do not commit)
graphify-out/

# Bubblewrap / Android TWA project (generated by `bubblewrap init`).
# Kept out of the Next.js root on purpose: Bubblewrap emits an `app/` dir, and
# Next prefers a root `app/` over `src/app/` — if it sits at the root the Next
# build silently produces zero routes.
/android/
# Android signing key — NEVER commit. Losing it means you cannot ship app updates.
*.keystore
*.jks

